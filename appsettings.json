{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "DtsConnection": {
    "IpAddress": "",
    "Port": 3001
  },
  "FrmcConfiguration": {
    "DefaultIpAddress": "localhost",
    "ControlPort": 6164,
    "DataStreamPort": 6165,
    "UseSecure": true
  },
  "ModbusServer": {
    "Port": 502
  },
  "WebSocketServers": {
    "ControlPort": 6164,
    "DataStreamPort": 6165
  },
  "Jwt": {
    "Secret": "your_super_secret_jwt_key_that_is_at_least_32_characters_long"
  },
  "BackgroundServices": {
    "DtsBackgroundServiceEnabled": true,
    "DtsHealthBackgroundServiceEnabled": true,
    "AlarmPublisherServiceEnabled": true
  },
  "ConsoleSettings": {
    "EnableConsole": true,
    "LogToFile": true,
    "LogFileName": "console.log"
  },
  "AllowedHosts": "*"
}
